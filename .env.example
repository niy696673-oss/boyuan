PLATFORM_MODE=production
HOST=0.0.0.0
PORT=4174
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgresql://boyuan:replace-with-a-long-random-secret@127.0.0.1:5432/boyuan
REDIS_URL=redis://127.0.0.1:6379
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=boyuan-documents
OBJECT_STORAGE_ACCESS_KEY=boyuan
OBJECT_STORAGE_SECRET_KEY=replace-with-a-long-random-secret
OBJECT_STORAGE_FORCE_PATH_STYLE=true
AUTH_MODE=jwt
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=boyuan-auth
JWT_AUDIENCE=boyuan-workbench
BOOTSTRAP_ADMIN_EMAIL=admin@boyuan.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL_NAME=qwen3:8b
LOCAL_MODEL_API_KEY=ollama
MODEL_ROUTE=external_only
EXTERNAL_MODEL_BASE_URL=https://api.deepseek.com
EXTERNAL_MODEL_NAME=deepseek-v4-flash
# EXTERNAL_MODEL_API_KEY=
EXTERNAL_MODELS_ENABLED=true
EMBEDDING_DIMENSIONS=384
LOG_LEVEL=info

# BP analysis: keep deterministic for ordinary local development; set to
# opencode to require the real OpenCode + project skill + Sequential Thinking path.
BOYUAN_ANALYSIS_ADAPTER=deterministic
BOYUAN_OPENCODE_BASE_URL=http://127.0.0.1:4173/opencode-api/
BOYUAN_OPENCODE_TIMEOUT_MS=600000
# BOYUAN_OPENCODE_DIRECTORY=/absolute/path/to/boyuan
# BOYUAN_OPENCODE_USERNAME=opencode
# BOYUAN_OPENCODE_PASSWORD=
BOYUAN_DEEP_OPENCODE_PROVIDER_ID=openai
BOYUAN_DEEP_OPENCODE_MODEL_ID=gpt-5.6-sol
BOYUAN_DEEP_OPENCODE_VARIANT=xhigh
