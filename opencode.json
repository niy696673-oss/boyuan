{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "instructions": [".opencode/instructions/boyuan-research-boundaries.md"],
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": [
        "node",
        "node_modules/@modelcontextprotocol/server-sequential-thinking/dist/index.js"
      ],
      "enabled": true,
      "timeout": 10000
    },
    "exa-websearch": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?exaApiKey={env:EXA_API_KEY}",
      "enabled": true,
      "oauth": false,
      "timeout": 30000
    },
    "nei-pevc": {
      "type": "remote",
      "url": "https://nei-pevc.com/api/mcp",
      "headers": {
        "Authorization": "{env:NEI_MCP_AUTHORIZATION}"
      },
      "enabled": true,
      "oauth": false,
      "timeout": 30000
    }
  },
  "permission": {
    "skill": {
      "boyuan-bp-deep-analysis": "allow"
    }
  }
}
