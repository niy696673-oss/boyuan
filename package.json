{
  "name": "boyuan-ai-workbench",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch --env-file-if-exists=.env.local server/index.ts\" \"vite\"",
    "dev:web": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env.local server/index.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env.local server/worker.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env.local server/index.ts",
    "worker": "NODE_ENV=production tsx --env-file-if-exists=.env.local server/worker.ts",
    "migrate": "tsx server/migrate.ts",
    "infra:up": "docker compose up -d postgres redis minio",
    "infra:down": "docker compose down",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx server/seed.ts",
    "import:knowledge": "tsx server/import-directory.ts",
    "migrate:legacy-research": "tsx server/migrate-legacy-research-platform.ts",
    "opencode:serve": "opencode serve --hostname 127.0.0.1 --port 4096"
  },
  "dependencies": {
    "@modelcontextprotocol/server-sequential-thinking": "2026.7.4",
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@gsap/react": "^2.1.2",
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.0.9",
    "cors": "latest",
    "express": "latest",
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "lucide-react": "latest",
    "mammoth": "^1.12.0",
    "multer": "latest",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "saxes": "^6.0.0",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/pg": "^8.20.4",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/supertest": "latest",
    "concurrently": "latest",
    "jsdom": "latest",
    "opencode-ai": "1.18.22",
    "prettier": "^3.9.6",
    "supertest": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
